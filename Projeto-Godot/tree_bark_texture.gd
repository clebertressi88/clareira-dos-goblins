extends RefCounted
# Textura fotografica de casca, reduzida a 128px para ficar compacta no GitHub.
# O arquivo original 1024px fica preservado na biblioteca do projeto ChatGPT.
const JPG64 := ""
static func make_texture() -> ImageTexture:
	var raw := Marshalls.base64_to_raw(JPG64)
	var image := Image.new()
	var err := image.load_jpg_from_buffer(raw)
	if err != OK:
		push_error("Falha lendo textura de casca em JPG: " + str(err))
		return null
	image.generate_mipmaps()
	return ImageTexture.create_from_image(image)
