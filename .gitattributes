# Normalize textos do Godot no Git; mantenha scripts Windows em CRLF.
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gdshader text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
